# Copy to .env and fill in. Names follow Meltano's TARGET_DATABRICKS_<SETTING> convention,
# so `meltano run` picks them up directly and the live tests (tests/test_live.py) use the same ones.

# Workspace hostname (no https://), e.g. dbc-1234abcd-5678.cloud.databricks.com
TARGET_DATABRICKS_SERVER_HOSTNAME=
# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/1234567890abcdef
TARGET_DATABRICKS_HTTP_PATH=
# Personal access token (auth_type=pat, the default)
TARGET_DATABRICKS_ACCESS_TOKEN=

# Optional
# Unity Catalog name; defaults to the warehouse default catalog
# TARGET_DATABRICKS_CATALOG=
# Schema used by `meltano run` (the live tests create and drop their own)
# TARGET_DATABRICKS_DEFAULT_TARGET_SCHEMA=smoke_test
# upsert | append-only | overwrite
# TARGET_DATABRICKS_LOAD_METHOD=upsert

# OAuth M2M (service principal) instead of a token
# TARGET_DATABRICKS_AUTH_TYPE=oauth_m2m
# TARGET_DATABRICKS_CLIENT_ID=
# TARGET_DATABRICKS_CLIENT_SECRET=
